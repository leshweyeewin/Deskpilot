# Copy to .env and fill in. .env is gitignored.

# --- Model (hackathon requires Gemini 3.5 or newer) ---
# Set to a model id your project can access.
DESKPILOT_MODEL=gemini-3.5-flash

# --- Auth: pick ONE path ---

# Path A -- Gemini API key (simplest for local dev / demo):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-gemini-api-key

# Path B -- Vertex AI (uncomment and use instead of the API key above):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Firestore memory bank (optional locally; set project to enable) ---
# When GOOGLE_CLOUD_PROJECT is set and the SDK can auth, memory uses Firestore;
# otherwise it falls back to data/memory_fallback.json automatically.
DESKPILOT_FIRESTORE_COLLECTION=deskpilot_memory

# --- Portfolio source ---
# Preferred: a published Google Sheet read as CSV (no credentials).
# In Sheets: File -> Share -> Publish to web -> pick the tab -> CSV -> Publish,
# then paste the .../pub?...&output=csv link here. See data/portfolio_template.csv
# for the expected columns. When unset, Deskpilot uses the shipped JSON sample.
# DESKPILOT_PORTFOLIO_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv

# Reporting currency for the snapshot (positions stay in their own currency).
# DESKPILOT_BASE_CURRENCY=SGD

# Offline JSON fallback (used only when no CSV URL is set):
# DESKPILOT_PORTFOLIO_SNAPSHOT=data/portfolio_snapshot.json

# --- Notifications (optional) ---
# Deliver the finished daily plan to Telegram. Create a bot via @BotFather for the
# token; get your chat id from @userinfobot (or from getUpdates). When either is
# unset, plan delivery is skipped and the run still succeeds.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=123456789
